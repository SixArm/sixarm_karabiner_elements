{
    "description": "Change from right_command to ctrl-b tmux prefix",
    "manipulators": [
        {
            "from": {
                "key_code": "right_command",
                "modifiers": {
                    "optional": ["any"]
                }
            },
            "to": [
                {
                    "key_code": "b",
                    "modifiers": ["control"]
                }
            ],
            "type": "basic"
        }
    ]
}
